# Tide: TestFlight 配布（自動署名、App Store Connect API Key、match 不使用）
default_platform(:ios)

platform :ios do
  desc "Archive → TestFlight（Secrets が揃っている前提。testflight.yml から呼ぶ）"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    team_id = ENV.fetch("TEAM_ID")
    project = "Tide.xcodeproj"

    update_code_signing_settings(
      path: project,
      use_automatic_signing: true,
      team_id: team_id,
      targets: ["Tide"]
    )

    build_number = (latest_testflight_build_number(api_key: api_key, app_identifier: "jp.tide.app", initial_build_number: 0) + 1).to_s

    build_app(
      project: project,
      scheme: "Tide",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{api_key[:key_filepath] || ''} CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{team_id}",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      },
      output_directory: "build/ipa",
      skip_profile_detection: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
