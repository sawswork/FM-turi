# Tide: TestFlight 配布（自動署名、App Store Connect API Key、match 不使用）
default_platform(:ios)

platform :ios do
  desc "Archive → TestFlight（Secrets が揃っている前提。testflight.yml から呼ぶ）"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("TEAM_ID")
    key_path = File.expand_path("AuthKey_#{key_id}.p8", Dir.tmpdir)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    project = "Tide.xcodeproj"
    update_code_signing_settings(
      path: project,
      use_automatic_signing: true,
      team_id: team_id
    )

    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: "jp.tide.app", initial_build_number: 0)
    rescue StandardError => e
      UI.important("TestFlight のビルド番号を取得できません（初回なら正常）: #{e.message}")
      0
    end
    build_number = (latest.to_i + 1).to_s

    auth_args = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
                "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"

    build_app(
      project: project,
      scheme: "Tide",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "#{auth_args} CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: auth_args,
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id,
        uploadSymbols: true
      },
      output_directory: "build/ipa",
      skip_profile_detection: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
